# ─────────────────────────────────────────────────────
#  DARKWEB MONITOR — Environment Variables
#  Copy this file to .env and fill in your real values
# ─────────────────────────────────────────────────────

# ── Core API Keys ──────────────────────────────────────
VT_API_KEY=your_virustotal_api_key_here
GROQ_API_KEY=your_groq_api_key_here
API_SECRET=darkweb_secret_2024

# ── Email Alerts (Gmail recommended) ──────────────────
EMAIL_ENABLED=true
EMAIL_SENDER=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_RECEIVER=alert_receiver@gmail.com
EMAIL_SMTP=smtp.gmail.com
EMAIL_PORT=587

# ── WhatsApp Alerts (Twilio) ───────────────────────────
WA_ENABLED=true
TWILIO_SID=your_twilio_account_sid
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_WA_FROM=whatsapp:+14155238886
TWILIO_WA_TO=whatsapp:+91your_number_here

# ── Pastebin Monitor ───────────────────────────────────
PASTE_KEYWORDS=password,leaked,hack,breach,credentials,dump
PASTE_DOMAINS=yourdomain.com,yourcompany.com
